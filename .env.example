# Twilio WhatsApp sandbox credentials. Copy to .env and fill in real values.
# https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sender number in the form `whatsapp:+14155238886` (sandbox default).
TWILIO_WHATSAPP_NUMBER=

# OpenAI API key used by services/amaaii.js (Phase 0 LLM provider).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Express port. Defaults to 3000 if unset.
PORT=3000

# Twilio webhook signature enforcement.
# - Unset / empty: enforce only when NODE_ENV=production (warn-only otherwise).
# - "true": always enforce (reject with 403 on bad/missing signature).
# - "false": never enforce (warn-only — useful for local smoke tests).
TWILIO_SIGNATURE_ENFORCE=

# Phase 4 (pilot hardening) — durable job queue + observability.
# All optional; sane defaults apply when unset (see CLAUDE.md's Environment
# section for the full rationale).

# Poll interval (ms) for the durable job-queue worker. Defaults to 15000.
JOB_POLL_MS=

# Bearer token required on GET /metrics (Authorization: Bearer <token>).
# Unset: served openly in non-production, 404s in production. Set this
# before exposing /metrics on any deploy reachable from the open internet.
METRICS_TOKEN=

# Webhook (e.g. a Slack incoming webhook URL) that receives a small
# PII-free JSON alert payload on critical failures. Optional — critical
# failures always log an ERROR-level line regardless of this being set.
ALERT_WEBHOOK_URL=

# Job-execution failures within a single poll cycle before an alert
# fires. Defaults to 3.
JOBS_FAILED_ALERT_THRESHOLD=
