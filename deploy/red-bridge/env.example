# /srv/amaaii/app/.env on red-bridge — copy, fill in, then: chmod 600 .env
# Git-ignored. `sudo systemctl restart amaaii-api` after any change.

NODE_ENV=production
PORT=8002
HOST=127.0.0.1                       # nginx is the only public entrance
DB_PATH=/srv/amaaii/data/amaaii.db   # outside the checkout: deploys never touch it

# Mandatory. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Bearer token for GET /metrics (404s in production when unset)
METRICS_TOKEN=
# The public https:// URL, no trailing slash (WhatsApp consent links to /privacy)
PUBLIC_BASE_URL=https://amaaii.com
# NEXT_PUBLIC_WHATSAPP_NUMBER is read by `pnpm build:web`, not by the server:
# put it in apps/web/.env.production (Next loads that at build time) to show
# "chat on WhatsApp" links in the app. Unset = no links. Digits or +E.164.

# Which WhatsApp transport sends and replies: twilio (default) or meta.
# Flipping this + a restart is the whole cutover, and the whole rollback.
WHATSAPP_PROVIDER=twilio

# Meta WhatsApp Cloud API (used when WHATSAPP_PROVIDER=meta).
# Account IDs, where each value comes from, and the runbook: WHATSAPP.md
# Access token: a System User token (never-expiring), not the 24h one.
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# App settings -> Basic -> App secret (signs every webhook delivery)
META_APP_SECRET=
# Any random string; paste the same value into Meta's webhook config
META_WEBHOOK_VERIFY_TOKEN=
# Approved AUTHENTICATION template for PWA sign-in codes (unset = plain text,
# which only reaches users inside the 24h window)
META_WA_OTP_TEMPLATE=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SIGNATURE_ENFORCE=true
OPENAI_API_KEY=
# Set to route AI replies through OpenRouter instead (wins over OPENAI_API_KEY).
# llm.ts sends provider.data_collection=deny on every request, so only
# providers that neither store nor train on prompts are used.
OPENROUTER_API_KEY=
# Optional: one model for every LLM call, e.g. openai/gpt-4o-mini
LLM_MODEL=
# Optional: model for the journal field extractors only (wins over LLM_MODEL),
# e.g. anthropic/claude-haiku-5.5 — keep it fast, the user waits on it.
LLM_EXTRACT_MODEL=

# Optional: Slack/on-call webhook for critical alerts
ALERT_WEBHOOK_URL=
