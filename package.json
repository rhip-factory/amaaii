{
  "name": "whatsapp-pregnancy-bot",
  "version": "0.2.0",
  "description": "WhatsApp bot for pregnant mothers using GPT",
  "main": "apps/server/src/index.ts",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  },
  "scripts": {
    "start": "tsx apps/server/src/index.ts",
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "pnpm --filter web dev",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "pnpm --filter web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.24.1",
    "sqlite3": "^5.1.7",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}